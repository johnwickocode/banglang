// BangLang Snake Game (Arrow keys + On-screen Touch D-pad)
জানালাখোলো(৬০০, ৫৪০);
গতিসেট(৬০);

সংখ্যা সাপ_এক্স = তালিকাতৈরি();
সংখ্যা সাপ_ওয়াই = তালিকাতৈরি();

তালিকায়যোগ(সাপ_এক্স, ১০);
তালিকায়যোগ(সাপ_ওয়াই, ১০);
তালিকায়যোগ(সাপ_এক্স, ৯);
তালিকায়যোগ(সাপ_ওয়াই, ১০);
তালিকায়যোগ(সাপ_এক্স, ৮);
তালিকায়যোগ(সাপ_ওয়াই, ১০);

সংখ্যা দিক_এক্স = ১;
সংখ্যা দিক_ওয়াই = ০;
সংখ্যা খাবার_এক্স = এলোমেলো(০, ২৯);
সংখ্যা খাবার_ওয়াই = এলোমেলো(০, ১৯);
সংখ্যা স্কোর = ০;
সংখ্যা টিক = ০;
সংখ্যা খেলা_শেষ = ০;

// লুপের বাইরে ভেরিয়েবল ঘোষণা (stack-safe)
সংখ্যা দৈর্ঘ্য = ৩;
সংখ্যা নতুন_এক্স = ০;
সংখ্যা নতুন_ওয়াই = ০;
সংখ্যা সূচক = ০;
সংখ্যা সেগ_এক্স = ০;
সংখ্যা সেগ_ওয়াই = ০;
সংখ্যা স্পর্শ = ০;
সংখ্যা স্পর্শ_এক্স = ০;
সংখ্যা স্পর্শ_ওয়াই = ০;

যতক্ষণ (জানালাবন্ধ() == ০) {
    // কীবোর্ড ইনপুট (Right=262, Left=263, Down=264, Up=265)
    যদি (বোতামচাপা(২৬২) == ১ এবং দিক_এক্স != ০ - ১) {
        দিক_এক্স = ১;
        দিক_ওয়াই = ০;
    };
    যদি (বোতামচাপা(২৬৩) == ১ এবং দিক_এক্স != ১) {
        দিক_এক্স = ০ - ১;
        দিক_ওয়াই = ০;
    };
    যদি (বোতামচাপা(২৬৪) == ১ এবং দিক_ওয়াই != ০ - ১) {
        দিক_এক্স = ০;
        দিক_ওয়াই = ১;
    };
    যদি (বোতামচাপা(২৬৫) == ১ এবং দিক_ওয়াই != ১) {
        দিক_এক্স = ০;
        দিক_ওয়াই = ০ - ১;
    };

    // টাচ / মাউস D-pad ইনপুট
    স্পর্শ = মাউসচাপা();
    যদি (স্পর্শ == ১) {
        স্পর্শ_এক্স = মাউসএক্স();
        স্পর্শ_ওয়াই = মাউসওয়াই();

        // উপর (Up): x=274..326, y=412..464
        যদি (স্পর্শ_এক্স >= ২৭৪ এবং স্পর্শ_এক্স <= ৩২৬ এবং স্পর্শ_ওয়াই >= ৪১২ এবং স্পর্শ_ওয়াই <= ৪৬৪ এবং দিক_ওয়াই != ১) {
            দিক_এক্স = ০;
            দিক_ওয়াই = ০ - ১;
        };
        // নিচ (Down): x=274..326, y=472..524
        যদি (স্পর্শ_এক্স >= ২৭৪ এবং স্পর্শ_এক্স <= ৩২৬ এবং স্পর্শ_ওয়াই >= ৪৭২ এবং স্পর্শ_ওয়াই <= ৫২৪ এবং দিক_ওয়াই != ০ - ১) {
            দিক_এক্স = ০;
            দিক_ওয়াই = ১;
        };
        // বাম (Left): x=214..266, y=472..524
        যদি (স্পর্শ_এক্স >= ২১৪ এবং স্পর্শ_এক্স <= ২৬৬ এবং স্পর্শ_ওয়াই >= ৪৭২ এবং স্পর্শ_ওয়াই <= ৫২৪ এবং দিক_এক্স != ১) {
            দিক_এক্স = ০ - ১;
            দিক_ওয়াই = ০;
        };
        // ডান (Right): x=334..386, y=472..524
        যদি (স্পর্শ_এক্স >= ৩৩৪ এবং স্পর্শ_এক্স <= ৩৮৬ এবং স্পর্শ_ওয়াই >= ৪৭২ এবং স্পর্শ_ওয়াই <= ৫২৪ এবং দিক_এক্স != ০ - ১) {
            দিক_এক্স = ১;
            দিক_ওয়াই = ০;
        };
    };

    টিক = টিক + ১;
    যদি (খেলা_শেষ == ০ এবং টিক >= ৮) {
        টিক = ০;
        দৈর্ঘ্য = তালিকাদৈর্ঘ্য(সাপ_এক্স);
        নতুন_এক্স = তালিকাহতে(সাপ_এক্স, ০) + দিক_এক্স;
        নতুন_ওয়াই = তালিকাহতে(সাপ_ওয়াই, ০) + দিক_ওয়াই;

        // দেয়ালের সাথে ধাক্কা
        যদি (নতুন_এক্স < ০ অথবা নতুন_এক্স >= ৩০ অথবা নতুন_ওয়াই < ০ অথবা নতুন_ওয়াই >= ২০) {
            খেলা_শেষ = ১;
        };

        // নিজের শরীরের সাথে ধাক্কা
        সূচক = ০;
        যতক্ষণ (সূচক < দৈর্ঘ্য) {
            সেগ_এক্স = তালিকাহতে(সাপ_এক্স, সূচক);
            সেগ_ওয়াই = তালিকাহতে(সাপ_ওয়াই, সূচক);
            যদি (নতুন_এক্স == সেগ_এক্স এবং নতুন_ওয়াই == সেগ_ওয়াই) {
                খেলা_শেষ = ১;
            };
            সূচক = সূচক + ১;
        };

        যদি (খেলা_শেষ == ০) {
            // খাবার খাওয়া
            যদি (নতুন_এক্স == খাবার_এক্স এবং নতুন_ওয়াই == খাবার_ওয়াই) {
                স্কোর = স্কোর + ১;
                তালিকায়যোগ(সাপ_এক্স, ০);
                তালিকায়যোগ(সাপ_ওয়াই, ০);
                দৈর্ঘ্য = তালিকাদৈর্ঘ্য(সাপ_এক্স);
                খাবার_এক্স = এলোমেলো(০, ২৯);
                খাবার_ওয়াই = এলোমেলো(০, ১৯);
            };

            // শরীর সরানো
            সূচক = দৈর্ঘ্য - ১;
            যতক্ষণ (সূচক > ০) {
                তালিকায়বসাও(সাপ_এক্স, সূচক, তালিকাহতে(সাপ_এক্স, সূচক - ১));
                তালিকায়বসাও(সাপ_ওয়াই, সূচক, তালিকাহতে(সাপ_ওয়াই, সূচক - ১));
                সূচক = সূচক - ১;
            };
            তালিকায়বসাও(সাপ_এক্স, ০, নতুন_এক্স);
            তালিকায়বসাও(সাপ_ওয়াই, ০, নতুন_ওয়াই);
        };
    };

    // আঁকা
    আঁকাশুরু();
    যদি (খেলা_শেষ == ১) {
        পটভূমিমুছো(৬০, ২০, ২০);
    } নাহলে {
        পটভূমিমুছো(২০, ২০, ৩০);
    };

    // খাবার ও সাপ
    আয়তআঁকো(খাবার_এক্স * ২০, খাবার_ওয়াই * ২০, ১৮, ১৮, ২২০, ৬০, ৬০);

    দৈর্ঘ্য = তালিকাদৈর্ঘ্য(সাপ_এক্স);
    সূচক = ০;
    যতক্ষণ (সূচক < দৈর্ঘ্য) {
        সেগ_এক্স = তালিকাহতে(সাপ_এক্স, সূচক);
        সেগ_ওয়াই = তালিকাহতে(সাপ_ওয়াই, সূচক);
        যদি (সূচক == ০) {
            আয়তআঁকো(সেগ_এক্স * ২০, সেগ_ওয়াই * ২০, ১৮, ১৮, ৮০, ২৫৫, ১২০);
        } নাহলে {
            আয়তআঁকো(সেগ_এক্স * ২০, সেগ_ওয়াই * ২০, ১৮, ১৮, ৪০, ১৮০, ৮০);
        };
        সূচক = সূচক + ১;
    };

    সংখ্যাআঁকো(স্কোর, ১০, ১০, ২০, ২৫৫, ২৫৫, ২৫৫);

    // কন্ট্রোল এরিয়া (y=400..540)
    আয়তআঁকো(০, ৪০০, ৬০০, ১৪০, ১৫, ১৫, ২৩);
    আয়তআঁকো(০, ৪০০, ৬০০, ২, ৬০, ৬০, ৮০);

    // D-pad বাটন
    আয়তআঁকো(২৭৪, ৪১২, ৫২, ৫২, ৪৫, ৪৫, ৬৫);
    আয়তআঁকো(২৭৪, ৪৭২, ৫২, ৫২, ৪৫, ৪৫, ৬৫);
    আয়তআঁকো(২১৪, ৪৭২, ৫২, ৫২, ৪৫, ৪৫, ৬৫);
    আয়তআঁকো(৩৩৪, ৪৭২, ৫২, ৫২, ৪৫, ৪৫, ৬৫);

    // বাটনের ভেতর তীর চিহ্ন (উপর, নিচ, বাম, ডান)
    আয়তআঁকো(২৯৬, ৪২৪, ৮, ২৪, ২১০, ২১০, ২৩০);
    আয়তআঁকো(২৮৮, ৪৩২, ২৪, ৬, ২১০, ২১০, ২৩০);

    আয়তআঁকো(২৯৬, ৪৮৬, ৮, ২৪, ২১০, ২১০, ২৩০);
    আয়তআঁকো(২৮৮, ৪৯৮, ২৪, ৬, ২১০, ২১০, ২৩০);

    আয়তআঁকো(২২৮, ৪৯৪, ২৪, ৮, ২১০, ২১০, ২৩০);
    আয়তআঁকো(২৩৪, ৪৮৬, ৬, ২৪, ২১০, ২১০, ২৩০);

    আয়তআঁকো(৩৪৮, ৪৯৪, ২৪, ৮, ২১০, ২১০, ২৩০);
    আয়তআঁকো(৩৬০, ৪৮৬, ৬, ২৪, ২১০, ২১০, ২৩০);

    আঁকাশেষ();
};

বন্ধকরো();
